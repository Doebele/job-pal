# ==============================================================================
# Job-Pal Environment Configuration
# Copy to .env and fill in values
# ==============================================================================

# --- Database ---
DB_HOST=job-pal-db
DB_USER=jobpal
DB_PASSWORD=jobpal_secret
DB_NAME=jobpal
# Interner DB-Port fuer Backend -> DB-Container (Docker-Netzwerk)
DB_INTERNAL_PORT=5432
# Host-Port fuer Zugriff vom Mac/Host auf Postgres
DB_EXTERNAL_PORT=5435
# Optional fuer nicht-containerisierte Backend-Runs
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# --- Email ---
# Choose one: RESEND or SMTP
RESEND_API_KEY=re_your_resend_key_here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=noreply@jobpal.ch

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# --- Security (production) ---
# CORS_ORIGIN=https://jobpal.ch
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
